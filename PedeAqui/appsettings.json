{
  "ConnectionStrings": {
    "Connection": "",
    "Redis": "redis:6379,abortConnect=false,connectTimeout=1000,asyncTimeout=1000"
  },
  "Settings": {
    "Jwt": {
      "SigningKey": "",
      "ExpiresMinutes": 60
    },
    "Admin": {
      "Name": "Administrador",
      "Email": "",
      "Password": ""
    },
    "Database": {
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 5
    }
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "RequestLimits": {
    "MaxOrderItems": 50,
    "MaxItemQuantity": 1000
  },
  "Redis": {
    "InstanceName": "",
    "ProductCacheTtlSeconds": 300,
    "TimeoutMilliseconds": 300,
    "FailureRatio": 0.5,
    "MinimumThroughput": 10,
    "SamplingDurationSeconds": 30,
    "BreakDurationSeconds": 15
  },
  "RateLimit": {
    "Login": {
      "Limit": 5,
      "WindowSeconds": 60
    },
    "Authenticated": {
      "Limit": 100,
      "WindowSeconds": 60
    }
  },
  "Idempotency": {
    "KeyTtlHours": 24,
    "InProgressLockSeconds": 60
  },
  "ApiEdge": {
    "MaxRequestBodyBytes": 65536,
    "RequestTimeoutSeconds": 10,
    "ShutdownTimeoutSeconds": 30
  },
  "Health": {
    "CheckTimeoutSeconds": 3
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "ClientProvidedName": "pedeaqui-api",
    "ConnectionTimeoutSeconds": 3,
    "NetworkRecoveryIntervalSeconds": 5
  },
  "AllowedHosts": "*"
}
