# Modelo do .env usado pelo docker-compose.
# Copie para .env (cp .env.example .env) e preencha com valores seus.
# O .env está no .gitignore: segredos nunca vão para o repositório.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

RABBITMQ_USER=pedeaqui
RABBITMQ_PASSWORD=

# Pelo menos 32 caracteres
JWT_SIGNING_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=
