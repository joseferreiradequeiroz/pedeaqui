{
  "ConnectionStrings": {
    "Connection": "",
    "Redis": "redis:6379,abortConnect=false,connectTimeout=1000,asyncTimeout=1000"
  },
  "Settings": {
    "Database": {
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 5
    }
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Redis": {
    "InstanceName": "",
    "ProductCacheTtlSeconds": 300,
    "TimeoutMilliseconds": 300,
    "FailureRatio": 0.5,
    "MinimumThroughput": 10,
    "SamplingDurationSeconds": 30,
    "BreakDurationSeconds": 15
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "ClientProvidedName": "pedeaqui-worker",
    "ConnectionTimeoutSeconds": 5,
    "PublishTimeoutSeconds": 5,
    "NetworkRecoveryIntervalSeconds": 5,
    "PrefetchCount": 10,
    "RetryDelaysSeconds": [5, 30, 120]
  },
  "Outbox": {
    "BatchSize": 50,
    "PollingIntervalMs": 1000
  },
  "PaymentGateway": {
    "BaseUrl": "http://payment-gateway:8080",
    "Bulkhead": {
      "MaxConcurrency": 10,
      "QueueLimit": 20
    },
    "TotalTimeoutSeconds": 10,
    "Retry": {
      "MaxRetryAttempts": 3,
      "DelayMilliseconds": 200
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDurationSeconds": 30,
      "BreakDurationSeconds": 15
    },
    "AttemptTimeoutSeconds": 2
  },
  "Orders": {
    "PendingExpirationMinutes": 15,
    "ExpirationBatchSize": 100
  },
  "Payments": {
    "ReconcileAfterMinutes": 10,
    "ReconcileBatchSize": 100
  },
  "Jobs": {
    "ExpirationIntervalSeconds": 60,
    "ReconciliationIntervalSeconds": 60,
    "IdempotencyCleanupIntervalMinutes": 60
  },
  "Worker": {
    "ShutdownTimeoutSeconds": 30,
    "HealthCheckDelaySeconds": 10,
    "HealthCheckIntervalSeconds": 30,
    "HealthCheckTimeoutSeconds": 5
  }
}
